APP_NAME="Surel Kendari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kdi_mail
DB_USERNAME=kdimail
DB_PASSWORD=secret

SESSION_DRIVER=database
# Nama cookie & prefiks cache dari nama lama "KDI Mail"; dipatok agar sesi login dan cache tidak putus saat APP_NAME berganti.
SESSION_COOKIE=kdi-mail-session
SESSION_LIFETIME=240
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=kdi-mail-cache-

# Brevo SMTP relay — email keluar. Kunci SMTP (bukan API key) dari
# Brevo > SMTP & API > SMTP.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="kominfo@ilmifaizan.cloud"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo API v3 (xkeysib-...) — dibutuhkan untuk email masuk (webhook inbound,
# unduh lampiran), mendaftarkan webhook, dan membaca sisa kredit akun.
# Kosong = kirim tetap jalan, fitur terima dinonaktifkan.
BREVO_API_KEY=
# Rahasia di URL webhook: /webhooks/brevo/{inbound|events}/{secret}
BREVO_WEBHOOK_SECRET=

# Reverb: email masuk & status kirim tampil realtime. Isi ID/KEY/SECRET acak
# (php artisan reverb:install membuatnya). REVERB_HOST/PORT/SCHEME = alamat yang
# dipakai Laravel menerbitkan event (servis `reverb` di jaringan Docker);
# REVERB_PUBLIC_* = alamat yang dihubungi browser.
#   dev : localhost / 8081 / http
#   prod: domain aplikasi / 443 / https (nginx meneruskan /app/ ke Reverb)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8081
REVERB_PUBLIC_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
