parameters:
	ignoreErrors:
		-
			message: '#^Unable to resolve the template type TKey in call to function collect$#'
			identifier: argument.templateType
			count: 1
			path: app/Console/Commands/BrevoSyncAccount.php

		-
			message: '#^Unable to resolve the template type TValue in call to function collect$#'
			identifier: argument.templateType
			count: 1
			path: app/Console/Commands/BrevoSyncAccount.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$name\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/Admin/ActivityController.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Pagination\\AbstractPaginator\<int,Spatie\\Activitylog\\Models\\Activity\>\:\:through\(\) contains unresolvable type\.$#'
			identifier: argument.unresolvableType
			count: 1
			path: app/Http/Controllers/Admin/ActivityController.php

		-
			message: '#^Part \$s \(array\|string\) of encapsed string cannot be cast to string\.$#'
			identifier: encapsedStringPart.nonString
			count: 1
			path: app/Http/Controllers/Admin/ActivityController.php

		-
			message: '#^Return type of call to method Illuminate\\Pagination\\AbstractPaginator\<int,Spatie\\Activitylog\\Models\\Activity\>\:\:through\(\) contains unresolvable type\.$#'
			identifier: method.unresolvableReturnType
			count: 1
			path: app/Http/Controllers/Admin/ActivityController.php

		-
			message: '#^Using nullsafe property access "\?\-\>name" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Http/Controllers/Admin/ActivityController.php

		-
			message: '#^Parameter \#1 \$audience of method App\\Services\\BroadcastPump\:\:audience\(\) expects array\{groups\?\: list\<int\>, contacts\?\: list\<int\>\}\|null, array\{groups\: array\<int\>, contacts\: array\<int\>\} given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/BroadcastController.php

		-
			message: '#^Match expression does not handle remaining value\: mixed$#'
			identifier: match.unhandled
			count: 2
			path: app/Http/Controllers/Contacts/ContactController.php

		-
			message: '#^Using nullsafe property access "\?\-\>mailbox" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Http/Controllers/Mail/AttachmentController.php

		-
			message: '#^Call to function abort_unless\(\) with bool and 422 will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: app/Http/Controllers/Mail/DraftController.php

		-
			message: '#^Method App\\Http\\Controllers\\Mail\\DraftController\:\:cleanList\(\) should return list\<array\{email\: string, name\: string\|null\}\> but returns array\<int, array\{email\: non\-empty\-string, name\: mixed\}\>\.$#'
			identifier: return.type
			count: 1
			path: app/Http/Controllers/Mail/DraftController.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Support\\Collection\<int,array\<string, string\|null\>\>\:\:reject\(\) expects array\{email\: string, name\: string\|null, kind\: string\}\|bool\|\(callable\(array\{email\: string, name\: string\|null, kind\: string\}, int\)\: bool\), Closure\(mixed\)\: \(non\-falsy\-string\|false\) given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/Mail/DraftController.php

		-
			message: '#^Method App\\Mail\\OutgoingMail\:\:attachments\(\) should return list\<Illuminate\\Mail\\Mailables\\Attachment\> but returns array\<int, Illuminate\\Mail\\Mailables\\Attachment\>\.$#'
			identifier: return.type
			count: 1
			path: app/Mail/OutgoingMail.php

		-
			message: '#^Method App\\Models\\Mailbox\:\:address\(\) should return Illuminate\\Database\\Eloquent\\Casts\\Attribute\<string, never\> but returns Illuminate\\Database\\Eloquent\\Casts\\Attribute\<non\-falsy\-string, never\>\.$#'
			identifier: return.type
			count: 1
			path: app/Models/Mailbox.php

		-
			message: '#^Method App\\Models\\Mailbox\:\:inboundAddress\(\) should return Illuminate\\Database\\Eloquent\\Casts\\Attribute\<string, never\> but returns Illuminate\\Database\\Eloquent\\Casts\\Attribute\<non\-falsy\-string, never\>\.$#'
			identifier: return.type
			count: 1
			path: app/Models/Mailbox.php

		-
			message: '#^Parameter \#1 \$array \(list\<string\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 2
			path: app/Services/DnsChecker.php

		-
			message: '#^Method App\\Services\\QuotaManager\:\:history\(\) should return list\<array\{date\: string, used\: int\}\> but returns array\<int, array\{date\: string, used\: int\}\>\.$#'
			identifier: return.type
			count: 1
			path: app/Services/QuotaManager.php

		-
			message: '#^Method App\\Support\\MailPresenter\:\:outgoingRow\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Support/MailPresenter.php

		-
			message: '#^Unable to resolve the template type TKey in call to function collect$#'
			identifier: argument.templateType
			count: 1
			path: app/Support/Settings.php

		-
			message: '#^Unable to resolve the template type TValue in call to function collect$#'
			identifier: argument.templateType
			count: 1
			path: app/Support/Settings.php
